<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:background="?attr/phWindowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hero Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/phHeroBackground"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔍 Pattern Detective"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="?attr/phHeroTextSub"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Theme Selector -->
        <LinearLayout
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/themeSystem"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:text="@string/theme_system"
                    android:textColor="?attr/phTextPrimary" />

                <RadioButton
                    android:id="@+id/themeLight"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:text="@string/theme_light"
                    android:textColor="?attr/phTextPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/themeDark"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:text="@string/theme_dark"
                    android:textColor="?attr/phTextPrimary" />

                <RadioButton
                    android:id="@+id/themeBurgundy"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:saveEnabled="false"
                    android:text="@string/theme_burgundy"
                    android:textColor="?attr/phTextPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Input Box -->
        <EditText
            android:id="@+id/input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/phInputBackground"
            android:hint="@string/input_hint"
            android:textColor="?attr/phTextPrimary"
            android:textColorHint="?attr/phTextTertiary"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:maxLines="4"
            android:inputType="textMultiLine"
            android:layout_marginTop="12dp" />

        <!-- Quick Utility Action Buttons (Equal Height 44dp, Equal Weight, Clean Word Wrapping) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnPaste"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="?attr/phButtonBackground"
                android:text="@string/btn_paste"
                android:textColor="?attr/phBrandText"
                android:textStyle="bold"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnRandom"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/phButtonBackground"
                android:text="@string/btn_random"
                android:textColor="?attr/phTextSecondary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/phButtonBackground"
                android:text="@string/btn_clear"
                android:textColor="?attr/phTextSecondary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Quick Samples Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/samples_title"
            android:textColor="?attr/phTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <!-- Quick Sample Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/sampleChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sample1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/phChipBackground"
                    android:text="@string/sample_1"
                    android:textColor="?attr/phChipText"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/sample2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/phChipBackground"
                    android:text="@string/sample_2"
                    android:textColor="?attr/phChipText"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/sample3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/phChipBackground"
                    android:text="@string/sample_3"
                    android:textColor="?attr/phChipText"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/sample4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/phChipBackground"
                    android:text="@string/sample_4"
                    android:textColor="?attr/phChipText"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/sample5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/phChipBackground"
                    android:text="@string/sample_5"
                    android:textColor="?attr/phChipText"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/sample6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/phChipBackground"
                    android:text="@string/sample_6"
                    android:textColor="?attr/phChipText"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/sample7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/phChipBackground"
                    android:text="@string/sample_7"
                    android:textColor="?attr/phChipText"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/sample8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/phChipBackground"
                    android:text="@string/sample_8"
                    android:textColor="?attr/phChipText"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Summary Metrics Card -->
        <LinearLayout
            android:id="@+id/summaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/phCardBackground"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/summary_title"
                android:textColor="?attr/phTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/statLength"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="?attr/phCardNestedBackground"
                    android:textColor="?attr/phTextSecondary"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/statUnique"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="?attr/phCardNestedBackground"
                    android:textColor="?attr/phTextSecondary"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/statEntropy"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="?attr/phCardNestedBackground"
                    android:textColor="?attr/phTextSecondary"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/statType"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="?attr/phCardNestedBackground"
                    android:textColor="?attr/phTextSecondary"
                    android:textSize="12sp"
                    android:textIsSelectable="true"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status / Header text (Selectable) -->
        <TextView
            android:id="@+id/statusHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/empty_prompt"
            android:textColor="?attr/phTextSecondary"
            android:textSize="14sp"
            android:textIsSelectable="true"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- High-Performance Recycled Pattern Cards View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Footer Link to Telegram -->
        <LinearLayout
            android:id="@+id/telegramLinkContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/phCardNestedBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️ "
                android:textSize="16sp" />

            <TextView
                android:id="@+id/telegramLinkText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/telegram_link"
                android:textColor="?attr/phBrandText"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

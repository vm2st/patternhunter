<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:layout_marginBottom="10dp"
    android:elevation="2dp">

    <!-- Card Top Header (Category + Snippet badge) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cardCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textIsSelectable="true"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cardSnippet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_nested_bg"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textIsSelectable="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Detailed Explanation Text (Selectable) -->
    <TextView
        android:id="@+id/cardDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textIsSelectable="true"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp" />

    <!-- Position / Metadata note (Selectable) -->
    <TextView
        android:id="@+id/cardPosition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:textIsSelectable="true"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

</LinearLayout>
